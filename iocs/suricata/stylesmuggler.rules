# StyleSmuggler / CVE-2026-75650 — Suricata/Snort-compatible network IDS rules
# Source: Sansec advisory 2026-09-05 (updated through 2026-09-07) + Adobe APSB26-146 +
# community IR. See ../../docs/VULNERABILITY.md. Covers both the Rust-implant campaign
# and the second, unrelated PHP web-shell attacker (SIDs 7000050+).
#
# Adjust $HOME_NET / $EXTERNAL_NET and SIDs (7000000-7000099 is an arbitrary local range
# — pick a range that doesn't collide with your existing local.rules) to your environment
# before deploying. These are a starting point, not a certified/maintained ruleset.
#
# REMINDER: at least one confirmed StyleSmuggler infection made NO outbound network
# traffic at all (it read Magento session data straight out of local Redis instead).
# These network rules will not catch that case — pair them with the host-based scanner.

# --- C2 / malware download infrastructure -----------------------------------------

alert tls $HOME_NET any -> 99.84.67.186 443 (msg:"STYLESMUGGLER C2 TLS WebSocket to known Magento implant C2"; flow:to_server,established; sid:7000001; rev:1; classtype:trojan-activity; reference:url,sansec.io/research/stylesmuggler-0day;)

alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for malware download host"; dns.query; content:"247.cdnflare.xyz"; nocase; sid:7000002; rev:1; classtype:trojan-activity; reference:url,sansec.io/research/stylesmuggler-0day;)

alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"STYLESMUGGLER TLS SNI to remote-shell C2 (windwsecurity.run)"; tls.sni; content:"windwsecurity.run"; nocase; sid:7000003; rev:1; classtype:trojan-activity;)

alert udp $HOME_NET any -> any 123 (msg:"STYLESMUGGLER possible NTP-shaped C2 to typosquat host (timesysnc/microsft)"; dns.query; content:"timesysnc.net"; nocase; sid:7000004; rev:1; classtype:trojan-activity;)
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for NTP-shaped C2 domain (typosquat)"; dns.query; content:"microsft.run"; nocase; sid:7000005; rev:1; classtype:trojan-activity;)
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for NTP-shaped C2 domain (typosquat)"; dns.query; content:"microsft.studio"; nocase; sid:7000006; rev:1; classtype:trojan-activity;)
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for malware download host (209.141.43.95 alias)"; dns.query; content:"cdnflare.xyz"; nocase; sid:7000007; rev:1; classtype:trojan-activity;)
alert ip $HOME_NET any -> 209.141.43.95 any (msg:"STYLESMUGGLER connection to known malware download host"; sid:7000008; rev:1; classtype:trojan-activity;)

# --- fc-cache / chronyd build C2 (NTP-shaped UDP/123 beaconing, first seen 2026-09-06) --

alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for fc-cache/chronyd build C2 (ntp.timesync.to)"; dns.query; content:"ntp.timesync.to"; nocase; sid:7000030; rev:1; classtype:trojan-activity; reference:url,sansec.io/research/stylesmuggler-0day;)
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for fc-cache/chronyd build C2 fallback (ntp.synctime.to)"; dns.query; content:"ntp.synctime.to"; nocase; sid:7000031; rev:1; classtype:trojan-activity;)
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER DNS lookup for fc-cache/chronyd build C2 fallback (ntp.syncstime.to)"; dns.query; content:"ntp.syncstime.to"; nocase; sid:7000032; rev:1; classtype:trojan-activity;)
# Behavioral fallback: flag unusually large/frequent UDP/123 packets to non-standard NTP
# servers. This is noisy — tune to your environment's actual NTP peers, or disable if
# you can't maintain an allowlist. Genuine NTP payloads are typically 48 bytes; this
# implant's beacons carry a larger chunked MessagePack payload past the first 4 bytes.
# alert udp $HOME_NET any -> !$NTP_SERVERS 123 (msg:"STYLESMUGGLER possible NTP-shaped C2 - oversized NTP-port packet to non-allowlisted host"; dsize:>60; sid:7000033; rev:1; classtype:trojan-activity;)

# --- Confirmed attacker source addresses (bulk/infra sources — see iocs/ips.txt for
#     which addresses are safe to block vs. which are shared residential proxy exits) --

alert http any 88.216.72.181 -> $HOME_NET any (msg:"STYLESMUGGLER known exploit source IP (Sansec-published)"; sid:7000010; rev:1; classtype:web-application-attack;)
alert http any 5.181.86.133 -> $HOME_NET any (msg:"STYLESMUGGLER known exploit source IP (CloudVPS, bulk)"; sid:7000011; rev:1; classtype:web-application-attack;)
alert http any 91.238.181.19 -> $HOME_NET any (msg:"STYLESMUGGLER known exploit source IP (AS49434, second wave)"; sid:7000012; rev:1; classtype:web-application-attack;)

# --- Exploit request shape (GraphQL styles[] abuse, trigger header, response marker) --

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER exploit attempt - styles[] on /graphql"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/graphql"; content:"styles"; distance:0; sid:7000020; rev:1; classtype:web-application-attack; reference:url,sansec.io/research/stylesmuggler-0day;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER trigger header family 1 (X-TRACE-<hex>)"; flow:to_server,established; http.header_names; content:"X-TRACE-"; pcre:"/X-TRACE-[0-9A-Fa-f]{10}/H"; sid:7000021; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER trigger header family 2 (X-<12hex>, TRACE dropped)"; flow:to_server,established; pcre:"/^X-[0-9A-Fa-f]{12}\x3a/Hm"; sid:7000022; rev:1; classtype:web-application-attack;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"STYLESMUGGLER response execution marker (MG<hex>::...::/MG<hex>)"; flow:to_client,established; file.data; pcre:"/MG[0-9a-f]{16,}::.{0,4096}::\/MG[0-9a-f]{16,}/"; sid:7000023; rev:1; classtype:trojan-activity;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER known scripted attacker user-agent on /graphql"; flow:to_server,established; http.user_agent; content:"python-requests"; http.uri; content:"/graphql"; sid:7000024; rev:1; classtype:web-application-attack;)

# --- fc-cache/chronyd build: outbound IP self-discovery (informational — these are
#     legitimate third-party services; the anomaly is a Magento backend calling them) --

alert http $HOME_NET any -> $EXTERNAL_NET 80 (msg:"STYLESMUGGLER informational - outbound IP-lookup call from application host (ipify)"; flow:to_server,established; http.host; content:"api4.ipify.org"; sid:7000040; rev:1; classtype:policy-violation; priority:3;)
alert http $HOME_NET any -> $EXTERNAL_NET 80 (msg:"STYLESMUGGLER informational - outbound IP-lookup call from application host (icanhazip)"; flow:to_server,established; http.host; content:"ipv4.icanhazip.com"; sid:7000041; rev:1; classtype:policy-violation; priority:3;)
alert http $HOME_NET any -> $EXTERNAL_NET 80 (msg:"STYLESMUGGLER informational - outbound IP-lookup call from application host (ident.me)"; flow:to_server,established; http.host; content:"ipv4.ident.me"; sid:7000042; rev:1; classtype:policy-violation; priority:3;)
alert http $HOME_NET any -> $EXTERNAL_NET 80 (msg:"STYLESMUGGLER informational - outbound IP-lookup call from application host (ipinfo.io)"; flow:to_server,established; http.host; content:"ipinfo.io"; sid:7000043; rev:1; classtype:policy-violation; priority:3;)

# =====================================================================================
# A SECOND, UNRELATED ATTACKER (confirmed 2026-09-07) — different operator, same
# StyleSmuggler entry point. Drops a PHP web shell via a recon probe that exfiltrates
# over DNS rather than an HTTP response. See ../../docs/VULNERABILITY.md.
# =====================================================================================

# The recon probe's DNS exfiltration channel — a generic OOB-canary domain used by many
# legitimate security tools, so this is a strong signal specifically when it originates
# from your Magento APPLICATION host, which has no legitimate reason to query it.
alert dns $HOME_NET any -> any any (msg:"STYLESMUGGLER second-attacker recon probe - DNS exfil to OOB canary domain (oast.site)"; dns.query; content:"oast.site"; nocase; sid:7000050; rev:1; classtype:trojan-activity; reference:url,sansec.io/research/stylesmuggler-0day;)

# The recon probe's cover request: a legitimate-looking storeConfig GraphQL query,
# used as camouflage while the real payload rides in the Store: header. Matching the
# GraphQL body pattern alone is noisy (this is a normal storefront query) - only alert
# when paired with an unusually long or non-standard Store: header value.
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER second-attacker recon probe - storeConfig cover query with oversized Store header"; flow:to_server,established; http.uri; content:"/graphql"; http.request_body; content:"storeConfig"; content:"store_code"; http.header_names; content:"Store"; pcre:"/^Store\x3a\s*.{40,}/Hm"; sid:7000051; rev:1; classtype:web-application-attack;)

# The web-shell path pattern, if a proxy/CDN logs the request URI for static assets
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"STYLESMUGGLER second-attacker web shell request pattern (pub/media cache path)"; flow:to_server,established; http.uri; content:"/pub/media/catalog/product/cache/ss_"; sid:7000052; rev:1; classtype:web-application-attack;)
